      "kind": "input",
      "refersTo": "field",
      "description": "Labeled white field with the shared blue keyboard outline.",
      "html": "<label class=\"ds-field\">이름<input class=\"ds-field-input\" placeholder=\"아티팩트 이름\" /></label>",
      "css": ".ds-field{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;display:flex;flex-direction:column;gap:7px;font-size:13px;font-weight:550;color:#363e4c;max-width:320px}.ds-field-input{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;font-size:14px;line-height:1.5;font-weight:400;color:var(--ink,#18191c);background:#fff;border:1px solid #cdd1d9;border-radius:7px;padding:10px 12px;min-height:40px;min-width:0}.ds-field-input::placeholder{color:#737b89}.ds-field-input:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}.ds-field-input:disabled{background:#f2f3f5;color:var(--muted,#626976)}"
    },
    {
      "name": "Workspace Navigation",
      "kind": "nav",
      "refersTo": "navigation-active",
      "description": "Sidebar row with a blue selected state and gray hover.",
      "html": "<nav class=\"ds-nav\" aria-label=\"작업 공간\"><button class=\"ds-nav-item ds-nav-active\" type=\"button\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"m12 3 9 5-9 5-9-5 9-5Z\"/><path d=\"m3 12 9 5 9-5M3 16l9 5 9-5\"/></svg>전체 아티팩트</button><button class=\"ds-nav-item\" type=\"button\">내 아티팩트</button></nav>",
      "css": ".ds-nav{background:var(--nav,#f3f4f6);padding:14px;display:grid;gap:3px;max-width:216px}.ds-nav-item{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;font-size:14px;line-height:1.55;display:flex;align-items:center;gap:11px;padding:9px 12px;min-height:39px;border:0;border-radius:7px;text-align:left;color:#414753;background:transparent;cursor:pointer}.ds-nav-item:hover{background:#e8eaef}.ds-nav-item.ds-nav-active{background:#dce7ff;color:#174fce;font-weight:600}.ds-nav-item:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}"
    },
    {
      "name": "Audience Label",
      "kind": "chip",
      "refersTo": "scope-label",
      "description": "Static audience metadata combines a lock icon and text; it is not a button.",
      "html": "<span class=\"ds-scope\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V6a4 4 0 0 1 8 0v4\"/></svg>나만 보기</span>",
      "css": ".ds-scope{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;display:inline-flex;align-items:center;gap:5px;font-size:12px;line-height:1.55;font-weight:400;background:#f1f3f7;color:#515b6b;border-radius:20px;padding:4px 8px;white-space:nowrap}"
    },
    {
      "name": "Artifact Card",
      "kind": "card",
      "refersTo": "artifact-card",
      "description": "Built card shown in its honest unavailable-preview state. Production uses the actual artifact launch URL, not this sample content.",
      "html": "<article class=\"ds-card\"><button class=\"ds-card-open\" type=\"button\" aria-label=\"아티팩트 열기\"><span class=\"ds-card-preview\">미리보기를 불러오지 못했습니다.</span><span class=\"ds-card-title\">아티팩트</span><span class=\"ds-card-description\">HTML</span></button><div class=\"ds-card-actions\"><button type=\"button\">열기</button><button type=\"button\">공유</button></div></article>",
      "css": ".ds-card{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;font-size:14px;line-height:1.55;max-width:340px;min-width:0;border:1px solid #d9dde5;background:#fff;border-radius:9px;overflow:hidden;transition:border-color .15s,box-shadow .15s;color:var(--ink,#18191c)}.ds-card:hover,.ds-card:focus-within{border-color:#6290f8;box-shadow:0 0 0 1px #6290f8}.ds-card-open{font-family:inherit;display:block;width:100%;border:0;background:none;color:inherit;text-align:left;padding:12px 12px 0;cursor:pointer}.ds-card-preview{display:flex;align-items:center;justify-content:center;aspect-ratio:16/10;border:1px solid #d5d9e2;background:#f2f4f7;border-radius:6px;color:#7a8391;font-size:12px}.ds-card-title{display:block;margin:13px 2px 3px;font-size:19px;line-height:1.5;font-weight:650;letter-spacing:-.4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.ds-card-description{display:block;color:#69717e;font-size:13px;margin:0 2px 12px}.ds-card-actions{display:flex;border-top:1px solid #e9ebf0;background:#fafbfc;min-height:39px}.ds-card-actions button{font-family:inherit;font-size:12px;white-space:nowrap;flex:1;padding:9px 12px;border:0;background:transparent;color:#596578;cursor:pointer}.ds-card-actions button+button{border-left:1px solid #e9ebf0}.ds-card-actions button:hover{background:#edf2ff;color:#1e50ca}.ds-card-open:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px;outline-offset:-3px}.ds-card-actions button:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}"
    },
    {
      "name": "Sharing Option",
      "kind": "custom",
      "description": "Selected audience radio with explicit owner and administrator semantics.",
      "html": "<label class=\"ds-visibility\"><svg width=\"19\" height=\"19\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"11\" rx=\"2\"/><path d=\"M8 10V6a4 4 0 0 1 8 0v4\"/></svg><span><b>나만 보기</b><small>작성자와 관리자만 접근</small></span><input type=\"radio\" name=\"ds-visibility\" checked /></label>",
      "css": ".ds-visibility{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;line-height:1.55;display:flex;align-items:center;gap:12px;border:1px solid #dce0e7;border-radius:7px;padding:12px 13px;max-width:360px;cursor:pointer;color:var(--ink,#18191c)}.ds-visibility:has(input:checked){border-color:#4774e7;background:#f4f7ff}.ds-visibility>svg{color:#5d6c84}.ds-visibility>span{flex:1;min-width:0}.ds-visibility b{display:block;font-size:13px;font-weight:550}.ds-visibility small{display:block;color:#697485;font-size:12px;margin-top:2px}.ds-visibility input{margin:0;accent-color:var(--accent,#2258e8);width:16px;height:16px}.ds-visibility input:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}.ds-visibility:has(input:disabled){cursor:default}"
