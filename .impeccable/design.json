      "css": ".ds-button-secondary{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;font-size:14px;line-height:1.4;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 15px;border:1px solid transparent;border-radius:7px;cursor:pointer;white-space:nowrap;transition:background .15s,border-color .15s;background:#fff;color:var(--ink,#18191c);border-color:#d6d9df;box-shadow:0 1px 2px #00000005;}.ds-button-secondary:hover:not(:disabled){background:#f6f7f9;border-color:#b9bec9;}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}.ds-button-secondary:disabled{opacity:.48;cursor:not-allowed}"
