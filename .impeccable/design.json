      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Built control variant for workspace actions.",
      "html": "<button class=\"ds-button-primary\" type=\"button\">새 아티팩트</button>",
      "css": ".ds-button-primary{font-family:Pretendard,-apple-system,BlinkMacSystemFont,\"Apple SD Gothic Neo\",system-ui,sans-serif;font-size:14px;line-height:1.4;font-weight:550;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:9px 15px;border:1px solid transparent;border-radius:7px;cursor:pointer;white-space:nowrap;transition:background .15s,border-color .15s;background:#17181b;color:#fff;border-color:#17181b;box-shadow:0 1px 2px #00000012;}.ds-button-primary:hover:not(:disabled){background:#32343a;}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#2258e8);outline-offset:3px}.ds-button-primary:disabled{opacity:.48;cursor:not-allowed}"
    },
