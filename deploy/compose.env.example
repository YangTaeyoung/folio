# Copy to .env (gitignored). This file contains configuration, never secrets.
FOLIO_IMAGE=folio:local
FOLIO_APP_URL=http://folio.localhost:4310
# Empty means <app-url>/c/{artifact}. Trusted publishers only: shared origin.
FOLIO_CONTENT_URL=
# Published on 127.0.0.1 only. Adjust advertised URL if changing a port.
FOLIO_PORT=4310
FOLIO_CONTENT_PORT=4311
# Isolated host mode example, with separate DNS/TLS and proxy upstream 4311:
# FOLIO_CONTENT_URL=https://{artifact}.artifacts.example.internal
